{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/xtreemze/slipmat/schema/server-extension-analysis-coverage-request-v1.schema.json",
  "title": "AnalysisCoverageRequestV1",
  "description": "Batch coverage query using only opaque host-neutral subject keys. Optional expectations allow deterministic stale classification.",
  "type": "object",
  "required": [
    "protocolVersion",
    "queries"
  ],
  "properties": {
    "protocolVersion": {
      "type": "string",
      "pattern": "^1\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$"
    },
    "queries": {
      "type": "array",
      "minItems": 1,
      "maxItems": 500,
      "items": {
        "type": "object",
        "required": [
          "subject"
        ],
        "properties": {
          "subject": {
            "type": "object",
            "required": [
              "version",
              "storeKey"
            ],
            "properties": {
              "version": {
                "const": 1
              },
              "storeKey": {
                "type": "string",
                "pattern": "^asv1-[0-9a-f]{64}$"
              }
            },
            "additionalProperties": false
          },
          "expectedSourceFingerprint": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "expectedSidecarSchemaVersion": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": true
}
