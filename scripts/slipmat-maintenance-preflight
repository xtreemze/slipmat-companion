#!/bin/sh
# Read-only preflight. This wrapper deliberately does not mask or start services.
set -eu
umask 077
if [ "$(id -u)" -ne 0 ]; then
    printf '%s\n' 'root is required for maintenance preflight' >&2
    exit 2
fi
exec /usr/bin/python3 /usr/local/libexec/slipmat-maintenance/host_guard.py "$@"
