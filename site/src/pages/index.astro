---
import BaseLayout from "../layouts/BaseLayout.astro";

const rawBase = import.meta.env.BASE_URL;\nconst base = rawBase.endsWith("/") ? rawBase : rawBase + "/";
const repositoryUrl = "https://github.com/xtreemze/slipmat-companion";
---

<BaseLayout
  title="Slipmat Companion — optional Jellyfin acceleration"
  description="Install and configure Slipmat Companion, the optional Audio Gateway extension for Jellyfin."
>
  <section class="hero">
    <div>
      <p class="eyebrow">Jellyfin Audio Gateway</p>
      <h1>More signal. Less server friction.</h1>
      <p class="lede">
        Slipmat Companion precomputes analysis, batches metadata, bridges browser-constrained resources,
        and can project cloud libraries through bounded read-only VFS — without becoming a second
        playback or product authority.
      </p>
      <div class="actions">
        <a class="button" href={base + "onboarding/"}>Set up Companion</a>
        <a class="button secondary" href={repositoryUrl}>View source</a>
      </div>
      <div class="status-strip" aria-label="Compatibility">
        <div><strong>Mode</strong><span>Optional acceleration</span></div>
        <div><strong>Server target</strong><span>Jellyfin 12.1.0</span></div>
        <div><strong>Client fallback</strong><span>Slipmat remains functional without it</span></div>
      </div>
    </div>
    <div class="gateway-visual" aria-hidden="true"></div>
  </section>

  <section class="section" aria-labelledby="purpose-title">
    <div class="section-intro">
      <h2 id="purpose-title">A companion, not a dependency.</h2>
      <p>
        The plugin accelerates work that Slipmat can still perform through canonical client and Rust paths.
        If the extension is absent, unhealthy, or partially configured, the client falls back instead of
        treating Companion as product authority.
      </p>
    </div>
    <div class="grid">
      <article class="card">
        <span class="number">01 / ANALYZE</span>
        <h3>Precompute audio evidence</h3>
        <p>Waveform, spectral, loudness, rhythm, source-boundary, harmonic-key and energy evidence can be prepared ahead of playback.</p>
      </article>
      <article class="card">
        <span class="number">02 / BRIDGE</span>
        <h3>Reduce browser constraints</h3>
        <p>Authenticated podcast, guide, directory and bounded media-relay endpoints provide server-side acquisition where browser CORS prevents direct access.</p>
      </article>
      <article class="card">
        <span class="number">03 / PROJECT</span>
        <h3>Keep cloud storage bounded</h3>
        <p>Optional rclone VFS profiles expose remote namespaces read-only while keeping source media authoritative and local cache disposable.</p>
      </article>
    </div>
  </section>

  <section class="section" aria-labelledby="evolution-title">
    <div class="section-intro">
      <div>
        <p class="eyebrow">Evolution</p>
        <h2 id="evolution-title">Built by removing unnecessary authority.</h2>
      </div>
      <div>
        <p>
          Companion began on 1 October 2026 as a standalone Jellyfin extension for work that was useful
          to precompute near the media server. Within days it grew from self-contained waveform analysis
          into higher-order audio evidence, provider-neutral server bridges, artwork palettes and bounded
          read-only cloud projection — while keeping Slipmat's playback model and Jellyfin's media catalog
          authoritative.
        </p>
        <div class="actions">
          <a class="button secondary" href={base + "story/"}>Read the project story</a>
          <a class="button secondary" href="https://github.com/xtreemze/slipmat-companion/releases">Browse releases</a>
        </div>
      </div>
    </div>
    <ol class="milestone-preview">
      <li><strong>01 Oct</strong><span>Standalone release, self-contained storage and integrated FFmpeg analysis.</span></li>
      <li><strong>02 Oct</strong><span>Directory/guide bridges and a provider-neutral rclone cloud adapter.</span></li>
      <li><strong>03 Oct</strong><span>Bounded VFS caching, artwork palettes and safer cloud diagnostics.</span></li>
      <li><strong>Next</strong><span>More useful acceleration without turning Companion into a second media or playback authority.</span></li>
    </ol>
  </section>

  <section class="section" aria-labelledby="install-title">
    <div class="section-intro">
      <h2 id="install-title">Install from Jellyfin.</h2>
      <div>
        <p>Add the public repository URL, install Audio Gateway, then restart Jellyfin. Core use does not require a separate analyzer service or artifact-store mount.</p>
        <div class="install-command">
          <code>https://xtreemze.github.io/slipmat-companion/manifest.json</code>
          <button class="copy" type="button" data-copy="https://xtreemze.github.io/slipmat-companion/manifest.json">Copy</button>
        </div>
      </div>
    </div>
    <div class="actions">
      <a class="button" href={base + "onboarding/"}>Open guided setup</a>
      <a class="button secondary" href={base + "manifest.json"}>Inspect manifest</a>
    </div>
  </section>

  <script>
    document.querySelectorAll("[data-copy]").forEach((element) => {
      const button = element as HTMLButtonElement;
      button.addEventListener("click", async () => {
        const value = button.getAttribute("data-copy");
        if (!value) return;
        await navigator.clipboard.writeText(value);
        button.textContent = "Copied";
      });
    });
  </script>
</BaseLayout>
